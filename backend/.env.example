DB_HOST=
DB_PORT=5432
DB_NAME=postgres
# Session Pooler: postgres.<project-ref> (no usar solo "postgres")
DB_USER=
# Si la contraseña tiene $ # & u otros especiales, usá comillas simples al hacer source en bash:
# DB_PASSWORD='tu-password'
DB_PASSWORD=

# none | resend
EMAIL_PROVIDER=none
# true por defecto. false solo junto con el perfil Spring local, nunca en producción.
CAMIDO_VERIFICACION_EMAIL_OBLIGATORIA=true
# SPRING_PROFILES_ACTIVE=local
RESEND_API_KEY=
RESEND_FROM=Cami-Do <onboarding@tu-dominio.com>
VERIFICACION_EMAIL_URL_BASE=http://localhost:4200/verificar-email
